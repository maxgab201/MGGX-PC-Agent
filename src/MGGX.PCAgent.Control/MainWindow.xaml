<Window x:Class="MGGX.PCAgent.Control.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Padding="28" Spacing="14" MaxWidth="620" HorizontalAlignment="Center">
    <TextBlock Text="MGGX PC Agent" FontSize="30" FontWeight="SemiBold" />
    <TextBlock x:Name="OnlineText" Text="● Checking Agent…" FontSize="18" />
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="18">
      <Grid ColumnSpacing="24" RowSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="Service"/><TextBlock x:Name="ServiceText" Grid.Column="1"/>
        <TextBlock Text="API" Grid.Row="1"/><TextBlock x:Name="ApiText" Grid.Row="1" Grid.Column="1"/>
        <TextBlock Text="Tailscale" Grid.Row="2"/><TextBlock x:Name="TailscaleText" Grid.Row="2" Grid.Column="1"/>
        <TextBlock Text="Sunshine" Grid.Row="3"/><TextBlock x:Name="SunshineText" Grid.Row="3" Grid.Column="1"/>
        <TextBlock Text="Windows uptime" Grid.Row="4"/><TextBlock x:Name="UptimeText" Grid.Row="4" Grid.Column="1"/>
      </Grid>
    </Border>
    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Button Content="COPY AGENT TOKEN" HorizontalAlignment="Stretch" Click="CopyToken_Click"/>
      <Button Grid.Column="1" Content="TEST AGENT" HorizontalAlignment="Stretch" Click="TestAgent_Click"/>
    </Grid>
    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Button Content="RESTART SERVICE" HorizontalAlignment="Stretch" Click="Restart_Click"/>
      <Button Grid.Column="1" Content="OPEN LOGS" HorizontalAlignment="Stretch" Click="OpenLogs_Click"/>
    </Grid>
    <CheckBox Content="Start automatically with Windows" IsChecked="True" IsEnabled="False"/>
    <Expander Header="Configuration">
      <StackPanel Spacing="10" Padding="0,10,0,0">
        <NumberBox x:Name="PortBox" Header="API port" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Inline"/>
        <CheckBox x:Name="DiscoveryCheck" Content="Enable LAN discovery (UDP 8767)"/>
        <Button Content="SAVE CONFIGURATION" Click="SaveConfig_Click"/>
      </StackPanel>
    </Expander>
    <InfoBar x:Name="Feedback" IsOpen="False" IsClosable="True"/>
  </StackPanel></ScrollViewer>
</Window>
